<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GovProcure Enterprise - National Bidding Platform</title>
  
  <!-- PWA & Mobile Web App Meta -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1e1b4b">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="GovProcure">
  <link rel="apple-touch-icon" href="/icon-192.png">

  <!-- Tailwind CSS & FontAwesome -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 flex flex-col min-h-screen antialiased selection:bg-amber-400 selection:text-indigo-950">

  <!-- Enterprise Header / Top Navbar -->
  <header class="bg-slate-950/80 backdrop-blur-md border-b border-slate-800 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        
        <!-- Brand Identity -->
        <a href="/" class="flex items-center space-x-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 to-indigo-600 flex items-center justify-center text-white shadow-lg shadow-indigo-900/30 group-hover:scale-105 transition">
            <i class="fa-solid fa-layer-group text-lg"></i>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xl font-extrabold tracking-tight text-white">GovProcure</span>
              <span class="text-[10px] uppercase font-bold tracking-widest bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 px-2 py-0.5 rounded">Enterprise</span>
            </div>
            <p class="text-[10px] text-slate-400 uppercase tracking-widest hidden sm:block">National E-Tendering Network</p>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="flex items-center space-x-2 sm:space-x-4">
          <a href="/" class="px-3 py-1.5 rounded-lg text-sm text-slate-300 hover:text-white hover:bg-slate-800 transition" data-i18n="nav_home">
            <i class="fa-solid fa-compass mr-1 text-slate-400"></i> Public Explorer
          </a>
          <a href="/manual" class="px-3 py-1.5 rounded-lg text-sm text-slate-300 hover:text-white hover:bg-slate-800 transition" data-i18n="nav_manual">
            <i class="fa-solid fa-book-bookmark mr-1 text-slate-400"></i> Manual
          </a>

          <% if (currentUser) { %>
            <% if (currentUser.role === 'official') { %>
              <a href="/govt/dashboard" class="px-3.5 py-1.5 rounded-lg text-sm bg-indigo-600 hover:bg-indigo-500 text-white font-medium shadow-sm transition">
                <i class="fa-solid fa-shield-halved mr-1.5 text-amber-400"></i> Govt Operations
              </a>
            <% } else { %>
              <a href="/bidder/dashboard" class="px-3.5 py-1.5 rounded-lg text-sm bg-indigo-600 hover:bg-indigo-500 text-white font-medium shadow-sm transition">
                <i class="fa-solid fa-briefcase mr-1.5 text-amber-400"></i> Bidder Hub
              </a>
            <% } %>

            <a href="/settings" class="px-3 py-1.5 rounded-lg text-sm text-slate-300 hover:text-white hover:bg-slate-800 transition" data-i18n="nav_settings">
              <i class="fa-solid fa-sliders mr-1 text-slate-400"></i> Settings
            </a>
            
            <a href="/logout" class="px-3 py-1.5 rounded-lg text-sm bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 border border-rose-500/30 transition">
              <i class="fa-solid fa-arrow-right-from-bracket"></i>
            </a>
          <% } else { %>
            <a href="/login" class="px-3.5 py-1.5 rounded-lg text-sm bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition" data-i18n="nav_login">
              Sign In
            </a>
            <a href="/register" class="px-3.5 py-1.5 rounded-lg text-sm bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold transition shadow-sm" data-i18n="nav_register">
              Enroll Entity
            </a>
          <% } %>

          <!-- Language Selector -->
          <div class="relative ml-2">
            <select id="langSelect" onchange="changeLanguage(this.value)" class="bg-slate-800 text-slate-200 text-xs rounded-lg border border-slate-700 px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-amber-400 cursor-pointer">
              <option value="en">English (EN)</option>
              <option value="hi">हिंदी (HI)</option>
              <option value="kn">ಕನ್ನಡ (KN)</option>
              <option value="ta">தமிழ் (TA)</option>
            </select>
          </div>

          <!-- PWA App Install Button (Dynamic) -->
          <button id="pwaInstallBtn" class="hidden px-3 py-1.5 rounded-lg text-xs bg-emerald-600 hover:bg-emerald-500 text-white font-semibold transition items-center shadow-lg">
            <i class="fa-solid fa-download mr-1.5"></i> Download App
          </button>
        </nav>
      </div>
    </div>
  </header>

  <!-- Notification Banner -->
  <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full">
    <% if (typeof success !== 'undefined' && success.length > 0) { %>
      <div class="mb-5 p-4 rounded-xl bg-emerald-950/60 border border-emerald-500/40 text-emerald-300 flex items-center shadow-lg">
        <i class="fa-solid fa-circle-check text-xl mr-3 text-emerald-400"></i>
        <span class="text-sm font-medium"><%= success %></span>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error.length > 0) { %>
      <div class="mb-5 p-4 rounded-xl bg-rose-950/60 border border-rose-500/40 text-rose-300 flex items-center shadow-lg">
        <i class="fa-solid fa-triangle-exclamation text-xl mr-3 text-rose-400"></i>
        <span class="text-sm font-medium"><%= error %></span>
      </div>
    <% } %>

    <% if (typeof info !== 'undefined' && info.length > 0) { %>
      <div class="mb-5 p-4 rounded-xl bg-sky-950/60 border border-sky-500/40 text-sky-300 flex items-center shadow-lg">
        <i class="fa-solid fa-circle-info text-xl mr-3 text-sky-400"></i>
        <span class="text-sm font-medium"><%= info %></span>
      </div>
    <% } %>
