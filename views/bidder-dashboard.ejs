<%- include('partials/header') %>
<div class="space-y-8">
  <!-- Bidder Profile Overview & Metrics Bar -->
  <div class="bg-slate-950 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white"><%= user.companyDetails.companyName || user.name %></h1>
        <span class="text-xs bg-emerald-950 border border-emerald-500/40 text-emerald-300 px-2.5 py-0.5 rounded-full font-semibold">Verified Bidder</span>
      </div>
      <p class="text-xs text-slate-400 mt-1">
        GST / Reg: <span class="font-mono text-amber-400"><%= user.companyDetails.registrationNumber || 'Pending Entry' %></span> | Representative: <%= user.name %>
      </p>
    </div>

    <!-- Bidder KPIs -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 w-full lg:w-auto">
      <div class="bg-slate-900 border border-slate-800 px-4 py-3 rounded-2xl text-center">
        <p class="text-[10px] uppercase font-bold text-slate-400">Total Bids</p>
        <p class="text-xl font-bold text-white mt-0.5"><%= bidderStats.bidsSubmitted %></p>
      </div>
      <div class="bg-slate-900 border border-slate-800 px-4 py-3 rounded-2xl text-center">
        <p class="text-[10px] uppercase font-bold text-slate-400">Won Awards</p>
        <p class="text-xl font-bold text-emerald-400 mt-0.5"><%= bidderStats.contractsWon %></p>
      </div>
      <div class="bg-slate-900 border border-slate-800 px-4 py-3 rounded-2xl text-center">
        <p class="text-[10px] uppercase font-bold text-slate-400">Success Rate</p>
        <p class="text-xl font-bold text-amber-400 mt-0.5"><%= bidderStats.winRate %>%</p>
      </div>
      <div class="bg-slate-900 border border-slate-800 px-4 py-3 rounded-2xl text-center">
        <p class="text-[10px] uppercase font-bold text-slate-400">Awarded Value</p>
        <p class="text-sm font-bold text-indigo-400 mt-1 font-mono">₹<%= (bidderStats.totalValueWon / 100000).toFixed(1) %>L</p>
      </div>
    </div>
  </div>

  <!-- Won Contracts Section with PDF Download -->
  <div class="bg-slate-950 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl">
    <h2 class="text-xl font-bold text-white mb-4 flex items-center">
      <i class="fa-solid fa-award text-amber-400 mr-2.5"></i> My Awarded Contracts (<%= wonTenders.length %>)
    </h2>

    <% if (wonTenders.length === 0) { %>
      <div class="bg-slate-900 border border-slate-800/80 rounded-2xl p-8 text-center text-slate-500 text-sm">
        No tenders currently awarded to your entity. Submit competitive quotes below to win government contracts.
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% wonTenders.forEach(tender => { %>
          <div class="bg-slate-900 border border-emerald-500/30 rounded-2xl p-5 flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start mb-2">
                <span class="text-xs font-mono font-bold text-emerald-400"><%= tender.tenderId %></span>
                <span class="text-xs uppercase bg-emerald-500/20 text-emerald-300 font-bold px-2 py-0.5 rounded">
                  <%= tender.status %>
                </span>
              </div>
              <h3 class="text-base font-bold text-white"><%= tender.title %></h3>
              <p class="text-xs text-slate-400 mt-1"><%= tender.location.taluk %>, <%= tender.location.district %>, <%= tender.location.state %></p>
              <p class="text-sm font-bold text-emerald-400 mt-2 font-mono">Budget: INR <%= tender.budget.toLocaleString('en-IN') %></p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-800 flex justify-end">
              <a href="/tenders/<%= tender._id %>/contract-download" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-bold transition flex items-center shadow-lg shadow-emerald-600/30" data-i18n="download_doc">
                <i class="fa-solid fa-file-pdf mr-2"></i> Download Contract File
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Bid Submission History Section (Enterprise Audit Trail) -->
  <div class="bg-slate-950 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl">
    <h2 class="text-xl font-bold text-white mb-4 flex items-center">
      <i class="fa-solid fa-clock-rotate-left text-indigo-400 mr-2.5"></i> My Bidding Submission History (<%= bidHistoryTenders.length %>)
    </h2>

    <% if (bidHistoryTenders.length === 0) { %>
      <div class="bg-slate-900 border border-slate-800/80 rounded-2xl p-8 text-center text-slate-500 text-sm">
        No bid submissions recorded in your audit logs.
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-900 border-b border-slate-800 text-slate-400 uppercase tracking-wider">
              <th class="p-3.5">Tender Ref & Title</th>
              <th class="p-3.5">Category</th>
              <th class="p-3.5">Tender Budget</th>
              <th class="p-3.5">My Bid Amount</th>
              <th class="p-3.5">Submission Date</th>
              <th class="p-3.5">Bid Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60">
            <% bidHistoryTenders.forEach(t => { %>
              <% const myBid = t.bids.find(b => b.bidderId.toString() === user._id.toString()); %>
              <tr class="hover:bg-slate-900/60 transition">
                <td class="p-3.5 font-semibold text-white">
                  <span class="font-mono text-indigo-400 block"><%= t.tenderId %></span>
                  <%= t.title %>
                </td>
                <td class="p-3.5 text-slate-300"><%= t.category %></td>
                <td class="p-3.5 text-slate-300 font-mono">₹<%= t.budget.toLocaleString('en-IN') %></td>
                <td class="p-3.5 text-amber-400 font-bold font-mono">₹<%= myBid ? myBid.bidAmount.toLocaleString('en-IN') : 'N/A' %></td>
                <td class="p-3.5 text-slate-400"><%= myBid ? new Date(myBid.submittedAt).toLocaleDateString() : 'N/A' %></td>
                <td class="p-3.5">
                  <% if (t.assignedBidder && t.assignedBidder._id.toString() === user._id.toString()) { %>
                    <span class="px-2.5 py-1 rounded-md bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 font-bold uppercase">Awarded</span>
                  <% } else if (t.status === 'assigned') { %>
                    <span class="px-2.5 py-1 rounded-md bg-rose-500/20 text-rose-300 border border-rose-500/40 font-bold uppercase">Not Selected</span>
                  <% } else { %>
                    <span class="px-2.5 py-1 rounded-md bg-sky-500/20 text-sky-300 border border-sky-500/40 font-bold uppercase">Under Evaluation</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- Available Tenders Explorer -->
  <div class="bg-slate-950 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl">
    <h2 class="text-xl font-bold text-white mb-4 flex items-center">
      <i class="fa-solid fa-folder-open text-amber-400 mr-2.5"></i> Open Government Tenders
    </h2>

    <form method="GET" action="/bidder/dashboard" class="grid grid-cols-1 sm:grid-cols-4 gap-3 mb-6 bg-slate-900 border border-slate-800 p-4 rounded-2xl">
      <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Tender title / ID" class="px-3.5 py-2 bg-slate-950 border border-slate-700 rounded-xl text-white text-xs">
      <input type="text" name="state" value="<%= filters.state || '' %>" placeholder="Filter by State" class="px-3.5 py-2 bg-slate-950 border border-slate-700 rounded-xl text-white text-xs">
      <input type="text" name="category" value="<%= filters.category || '' %>" placeholder="Category (Civil / Roads)" class="px-3.5 py-2 bg-slate-950 border border-slate-700 rounded-xl text-white text-xs">
      <button type="submit" class="py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs rounded-xl transition">
        Filter Tenders
      </button>
    </form>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% availableTenders.forEach(tender => { %>
        <% const hasBid = tender.bids.some(b => b.bidderId.toString() === user._id.toString()); %>
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center mb-2">
              <span class="text-xs font-mono font-bold text-indigo-400"><%= tender.tenderId %></span>
              <span class="text-xs bg-indigo-950 border border-indigo-700/40 text-indigo-300 font-semibold px-2 py-0.5 rounded"><%= tender.category %></span>
            </div>
            <h3 class="text-base font-bold text-white mb-1"><%= tender.title %></h3>
            <p class="text-xs text-slate-400 mb-3 line-clamp-3"><%= tender.description %></p>
            <div class="text-xs text-slate-400 space-y-1 mb-4">
              <div>Budget: <strong class="text-white font-mono">INR <%= tender.budget.toLocaleString('en-IN') %></strong></div>
              <div>Location: <%= tender.location.taluk %>, <%= tender.location.state %></div>
              <div>Bids Submitted: <%= tender.bids.length %></div>
            </div>
          </div>

          <% if (hasBid) { %>
            <div class="border-t border-slate-800 pt-3 text-center">
              <span class="text-xs font-semibold text-emerald-400 bg-emerald-950/60 border border-emerald-500/30 px-3 py-1.5 rounded-xl block">
                <i class="fa-solid fa-check mr-1"></i> Your Bid is Registered
              </span>
            </div>
          <% } else { %>
            <form action="/bidder/tenders/<%= tender._id %>/bid" method="POST" class="border-t border-slate-800 pt-3 space-y-2">
              <div>
                <label class="block text-[11px] font-semibold text-slate-300 mb-1">Your Price Quotation (INR)</label>
                <input type="number" name="bidAmount" required placeholder="e.g. <%= tender.budget %>" class="w-full px-3 py-1.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-xs">
              </div>
              <input type="text" name="proposalNote" placeholder="Timeline / Technical Note" class="w-full px-3 py-1.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-xs">
              <button type="submit" class="w-full py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs rounded-xl transition">
                Submit Sealed Bid
              </button>
            </form>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
