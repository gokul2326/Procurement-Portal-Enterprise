<%- include('partials/header') %>
<div class="max-w-4xl mx-auto my-6 space-y-6">
  <div class="bg-slate-950 border border-slate-800 rounded-2xl p-6 shadow-2xl">
    <h2 class="text-xl font-bold text-white mb-4 flex items-center" data-i18n="nav_settings">
      <i class="fa-solid fa-sliders text-indigo-400 mr-2"></i> Account Parameters & Enterprise Profile
    </h2>

    <form action="/settings/profile" method="POST" class="space-y-4">
      <div class="flex items-center space-x-5 pb-5 border-b border-slate-800">
        <img src="<%= user.profilePic %>" alt="Profile" class="w-16 h-16 rounded-full border-2 border-indigo-500 object-cover shadow-lg">
        <div class="flex-grow">
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Avatar Image URL</label>
          <input type="text" name="profilePic" value="<%= user.profilePic %>" class="w-full px-4 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Preferred System Language</label>
          <select name="preferredLanguage" class="w-full px-4 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer">
            <option value="en" <%= user.preferredLanguage === 'en' ? 'selected' : '' %>>English</option>
            <option value="hi" <%= user.preferredLanguage === 'hi' ? 'selected' : '' %>>हिंदी (Hindi)</option>
            <option value="kn" <%= user.preferredLanguage === 'kn' ? 'selected' : '' %>>ಕನ್ನಡ (Kannada)</option>
            <option value="ta" <%= user.preferredLanguage === 'ta' ? 'selected' : '' %>>தமிழ் (Tamil)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Operating Role</label>
          <input type="text" disabled value="<%= user.role.toUpperCase() %>" class="w-full px-4 py-2 bg-slate-900/60 border border-slate-800 rounded-xl text-slate-400 text-sm font-mono">
        </div>
      </div>

      <% if (user.role === 'bidder') { %>
        <div class="border-t border-slate-800 pt-4 space-y-4">
          <h3 class="text-sm font-bold text-white uppercase tracking-wider">Enterprise Entity Info</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Company Legal Name</label>
              <input type="text" name="companyName" value="<%= user.companyDetails.companyName %>" class="w-full px-4 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Registration / GST Identification</label>
              <input type="text" name="registrationNumber" value="<%= user.companyDetails.registrationNumber %>" class="w-full px-4 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm">
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Executed Project Portfolio</label>
            <textarea name="previousWorks" rows="2" class="w-full px-4 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm"><%= user.companyDetails.previousWorks %></textarea>
          </div>
        </div>
      <% } %>

      <button type="submit" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl text-sm transition">
        Update Settings
      </button>
    </form>
  </div>

  <div class="bg-slate-950 border border-slate-800 rounded-2xl p-6 shadow-2xl">
    <h3 class="text-base font-bold text-white mb-3 flex items-center">
      <i class="fa-solid fa-key text-amber-400 mr-2"></i> Security Password Modification
    </h3>
    <form action="/settings/password" method="POST" class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Current Password</label>
          <input type="password" name="currentPassword" required class="w-full px-4 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">New Alphanumeric Password</label>
          <input type="password" name="newPassword" required class="w-full px-4 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm">
        </div>
      </div>
      <button type="submit" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-xl text-sm transition border border-slate-700">
        Update Password
      </button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
