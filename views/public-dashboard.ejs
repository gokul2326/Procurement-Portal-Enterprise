<%- include('partials/header') %>
<div class="space-y-8">
  <!-- Hero Metrics Banner -->
  <div class="relative bg-gradient-to-br from-indigo-950 via-slate-900 to-slate-950 border border-indigo-900/40 rounded-3xl p-6 sm:p-10 overflow-hidden shadow-2xl">
    <div class="relative z-10 max-w-3xl">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20 mb-4">
        <i class="fa-solid fa-satellite-dish animate-pulse"></i> Live Public Transparency Network
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight" data-i18n="search_heading">
        Find Active Public Works in Your Locality
      </h1>
      <p class="text-slate-400 text-sm mt-2 mb-6">
        Search transparent public tenders and monitor contractor assignments, sanctioned public funds, and ground-level execution status.
      </p>
    </div>

    <!-- Quick Metrics Row -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8 pt-4 border-t border-slate-800">
      <div class="bg-slate-900/80 border border-slate-800 p-4 rounded-2xl">
        <p class="text-xs uppercase text-slate-400 font-semibold">Active Public Works</p>
        <p class="text-2xl font-extrabold text-indigo-400 mt-1"><%= metrics.activeProjects %></p>
      </div>
      <div class="bg-slate-900/80 border border-slate-800 p-4 rounded-2xl">
        <p class="text-xs uppercase text-slate-400 font-semibold">Completed Projects</p>
        <p class="text-2xl font-extrabold text-emerald-400 mt-1"><%= metrics.completedProjects %></p>
      </div>
      <div class="bg-slate-900/80 border border-slate-800 p-4 rounded-2xl">
        <p class="text-xs uppercase text-slate-400 font-semibold">Total Capital Allocated</p>
        <p class="text-2xl font-extrabold text-amber-400 mt-1">₹<%= (metrics.totalCapital / 10000000).toFixed(2) %> Cr</p>
      </div>
    </div>

    <!-- Location Filtering Form -->
    <form method="GET" action="/" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 bg-slate-900/90 border border-slate-800 p-4 rounded-2xl backdrop-blur-xl">
      <div>
        <label class="block text-[11px] uppercase font-bold text-slate-400 mb-1" data-i18n="state">State</label>
        <input type="text" name="state" value="<%= filters.state || '' %>" placeholder="e.g. Karnataka" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-xl text-white text-xs focus:ring-1 focus:ring-amber-400 focus:outline-none">
      </div>
      <div>
        <label class="block text-[11px] uppercase font-bold text-slate-400 mb-1" data-i18n="district">District</label>
        <input type="text" name="district" value="<%= filters.district || '' %>" placeholder="e.g. Bengaluru" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-xl text-white text-xs focus:ring-1 focus:ring-amber-400 focus:outline-none">
      </div>
      <div>
        <label class="block text-[11px] uppercase font-bold text-slate-400 mb-1" data-i18n="taluk">Taluk</label>
        <input type="text" name="taluk" value="<%= filters.taluk || '' %>" placeholder="e.g. Yelahanka" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-xl text-white text-xs focus:ring-1 focus:ring-amber-400 focus:outline-none">
      </div>
      <div>
        <label class="block text-[11px] uppercase font-bold text-slate-400 mb-1" data-i18n="village">Village / Ward</label>
        <input type="text" name="village" value="<%= filters.village || '' %>" placeholder="e.g. Singanayakanahalli" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-xl text-white text-xs focus:ring-1 focus:ring-amber-400 focus:outline-none">
      </div>
      <div class="flex items-end">
        <button type="submit" class="w-full py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl text-xs transition shadow-lg shadow-amber-500/20" data-i18n="search_btn">
          <i class="fa-solid fa-magnifying-glass mr-1"></i> Search Works
        </button>
      </div>
    </form>
  </div>

  <!-- Projects Grid -->
  <div>
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-xl font-bold text-white flex items-center">
        <i class="fa-solid fa-bars-progress text-amber-400 mr-2"></i> Verified Public Tenders (<%= runningTenders.length %>)
      </h2>
      <a href="/" class="text-xs text-indigo-400 hover:underline">Reset Filters</a>
    </div>

    <% if (runningTenders.length === 0) { %>
      <div class="bg-slate-950 border border-slate-800 rounded-2xl p-12 text-center text-slate-500">
        <i class="fa-solid fa-magnifying-glass-location text-4xl mb-3 text-slate-600"></i>
        <p class="font-medium">No projects found matching the specified location parameters.</p>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% runningTenders.forEach(tender => { %>
          <div class="bg-slate-950 border border-slate-800 hover:border-slate-700 rounded-2xl p-5 flex flex-col justify-between transition group shadow-xl">
            <div>
              <div class="flex justify-between items-start mb-3">
                <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-md bg-indigo-950/70 border border-indigo-700/40 text-indigo-300">
                  <%= tender.tenderId %>
                </span>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-md uppercase font-mono <%= tender.status === 'completed' ? 'bg-emerald-950/80 border border-emerald-500/40 text-emerald-300' : 'bg-blue-950/80 border border-blue-500/40 text-blue-300' %>">
                  <%= tender.status %>
                </span>
              </div>
              <h3 class="text-base font-bold text-white mb-2 group-hover:text-amber-400 transition"><%= tender.title %></h3>
              <p class="text-slate-400 text-xs mb-4 line-clamp-2"><%= tender.description %></p>
              
              <div class="bg-slate-900 border border-slate-800/80 rounded-xl p-3 text-xs space-y-1.5 mb-4">
                <div class="text-slate-300">
                  <i class="fa-solid fa-location-dot text-rose-400 mr-1.5"></i>
                  <%= tender.location.taluk %>, <%= tender.location.district %>, <%= tender.location.state %>
                </div>
                <div class="text-slate-300">
                  <i class="fa-solid fa-indian-rupee-sign text-emerald-400 mr-1.5"></i>
                  <span data-i18n="budget">Sanctioned Budget</span>: <strong>INR <%= tender.budget.toLocaleString('en-IN') %></strong>
                </div>
              </div>
            </div>

            <div class="border-t border-slate-800/80 pt-3">
              <span class="text-[10px] uppercase font-bold text-slate-500 tracking-wider block mb-1.5" data-i18n="tender_contractor">Executing Contractor:</span>
              <% if (tender.assignedBidder) { %>
                <div class="flex items-center space-x-2.5">
                  <div class="w-8 h-8 rounded-lg bg-indigo-600/30 border border-indigo-500/40 text-indigo-300 flex items-center justify-center font-bold text-xs">
                    <%= tender.assignedBidder.name.charAt(0) %>
                  </div>
                  <div>
                    <p class="text-xs font-bold text-white"><%= tender.assignedBidder.companyDetails.companyName || tender.assignedBidder.name %></p>
                    <p class="text-[10px] text-slate-400 font-mono">Reg: <%= tender.assignedBidder.companyDetails.registrationNumber || 'Verified Official' %></p>
                  </div>
                </div>
              <% } else { %>
                <p class="text-xs text-slate-500 italic">Contractor allocation in progress</p>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
